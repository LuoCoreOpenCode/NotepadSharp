<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ==================== 暗色主题 ==================== -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#FF252526"/>
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9D9D9D"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FF3C3C3C"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0E639C"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF2D4D7E"/>

    <!-- ==================== 系统色覆盖（让默认菜单模板变暗）==================== -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF252526"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FF252526"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF2D4D7E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF2D4D7E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF252526"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF252526"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFD4D4D4"/>

</ResourceDictionary>
