<UserControl x:Class="NotepadSharp.Controls.FindReplacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="900">
    <Border Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="8,6">
        <StackPanel>
            <!-- 查找行 -->
            <DockPanel LastChildFill="True">
                <Button Content="✕ 关闭" Width="60" DockPanel.Dock="Right" Click="OnClose" Margin="4,0,0,0"/>
                <Button Content="提取正则结果" Width="90" DockPanel.Dock="Right" Click="OnCopyRegexResult" Margin="4,0,0,0"
                        ToolTip="把正则匹配到的字段逐行复制到剪切板（ND2 Copy Regular Result）"/>
                <Button Content="全部标记" Width="68" DockPanel.Dock="Right" Click="OnMarkAll" Margin="4,0,0,0"
                        ToolTip="高亮全部匹配（ND2 Mark tab 的全部标记）"/>
                <Button Content="计数" Width="56" DockPanel.Dock="Right" Click="OnCount" Margin="4,0,0,0"
                        ToolTip="统计匹配数量"/>
                <Button Content="上一个" Width="60" DockPanel.Dock="Right" Click="OnFindPrevious" Margin="4,0,0,0"/>
                <Button Content="下一个" Width="60" DockPanel.Dock="Right" Click="OnFindNext" Margin="4,0,0,0"/>
                <TextBlock x:Name="MatchCountText" VerticalAlignment="Center" Width="150"
                           Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0"/>
                <TextBlock Text="查找:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="FindCombo" Width="240" IsEditable="True" Padding="3,2"
                          StaysOpenOnEdit="True" KeyDown="OnFindKeyDown"/>
            </DockPanel>

            <!-- 替换行 -->
            <DockPanel LastChildFill="True" Margin="0,6,0,0">
                <!-- DockPanel.Dock=Right：越靠前的子元素越靠右，故按「视觉从左到右」的逆序声明 -->
                <Button Content="清除全部" Width="70" DockPanel.Dock="Right" Click="OnClearAllMarks" Margin="4,0,0,0"
                        ToolTip="清除五种标记色（ND2 Clear All / F7），不动书签"/>
                <Button Content="清除标记" Width="70" DockPanel.Dock="Right" Click="OnClearMark" Margin="4,0,0,0"/>
                <Button Content="标记并加书签" Width="96" DockPanel.Dock="Right" Click="OnMarkWithBookmark" Margin="4,0,0,0"/>
                <Button Content="替换所有打开文件" Width="116" DockPanel.Dock="Right" Click="OnReplaceAllInOpened" Margin="4,0,0,0"
                        ToolTip="逐个文档做全部替换，只读文档跳过（ND2 Replace All in All Opened Documents）"/>
                <Button Content="在当前文件中替换" Width="116" DockPanel.Dock="Right" Click="OnReplaceAll" Margin="4,0,0,0"/>
                <Button Content="替换" Width="56" DockPanel.Dock="Right" Click="OnReplace" Margin="4,0,0,0"/>
                <TextBlock Text="替换:" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="ReplaceCombo" Width="240" IsEditable="True" Padding="3,2" StaysOpenOnEdit="True"/>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="模式:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <RadioButton x:Name="ModeNormalRadio" Content="普通" GroupName="SearchMode" IsChecked="True"
                                 Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                                 ToolTip="原样匹配字符串"/>
                    <RadioButton x:Name="ModeExtendRadio" Content="扩展" GroupName="SearchMode"
                                 Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                                 ToolTip="把 \n \r \t \0 \\ 与 \b八位二进制 \o三位八进制 \d三位十进制 \x两位十六进制 \u四位十六进制 还原成字符"/>
                    <RadioButton x:Name="ModeRegexRadio" Content="正则" GroupName="SearchMode"
                                 VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <WrapPanel Margin="16,0,0,0">
                    <CheckBox x:Name="MatchCaseCheckBox" Content="区分大小写" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                    <CheckBox x:Name="MatchWordCheckBox" Content="全字匹配" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                    <CheckBox x:Name="WrapCheckBox" Content="循环查找" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                    <CheckBox x:Name="BackwardCheckBox" Content="向后搜索" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="标记色:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="MarkColorCombo" Width="76" VerticalAlignment="Center"/>
                    <CheckBox x:Name="MarkLoopCheckBox" Content="轮色" IsChecked="True" Margin="8,0,0,0"
                              VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                              ToolTip="每按一次标记换下一种颜色，五种循环使用"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
