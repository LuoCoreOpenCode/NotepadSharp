<UserControl x:Class="NotepadSharp.Controls.SearchResultsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="900">
    <Border Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="8,6">
        <DockPanel LastChildFill="True">
            <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                <Button Content="✕ 关闭" Width="60" DockPanel.Dock="Right" Click="OnClose"/>
                <Button Content="复制全部" Width="70" DockPanel.Dock="Right" Click="OnCopyAll" Margin="4,0,0,0"/>
                <Button Content="跳转" Width="56" DockPanel.Dock="Right" Click="OnJump" Margin="4,0,0,0"/>
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Text="查找结果：双击一行可跳到对应位置。"/>
            </DockPanel>

            <ListView x:Name="ResultList" Margin="0,6,0,0" Height="150"
                      Background="{DynamicResource EditorBackgroundBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      MouseDoubleClick="OnResultDoubleClick"
                      PreviewKeyDown="OnListKeyDown">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="关键字" Width="140" DisplayMemberBinding="{Binding Term}"/>
                        <GridViewColumn Header="行" Width="60" DisplayMemberBinding="{Binding Line}"/>
                        <GridViewColumn Header="列" Width="60" DisplayMemberBinding="{Binding Column}"/>
                        <GridViewColumn Header="内容" Width="520" DisplayMemberBinding="{Binding Preview}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Border>
</UserControl>
