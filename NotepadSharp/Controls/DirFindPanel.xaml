<UserControl x:Class="NotepadSharp.Controls.DirFindPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="900">
    <Border Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="8,6">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
                <!-- 目录与文件类型 -->
                <DockPanel LastChildFill="True">
                    <Button Content="浏览…" Width="60" DockPanel.Dock="Right" Click="OnBrowse" Margin="4,0,0,0"/>
                    <Button Content="✕ 关闭" Width="60" DockPanel.Dock="Right" Click="OnClose" Margin="4,0,0,0"/>
                    <TextBlock Text="目录:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="RootTextBox" Padding="3,2" Margin="0,0,8,0"/>
                    <TextBlock Text="文件类型:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="FilterTextBox" Width="150" Padding="3,2" Text="*.*"/>
                    <CheckBox x:Name="RecursiveCheckBox" Content="递归" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                    <CheckBox x:Name="SkipHiddenCheckBox" Content="跳过隐藏" IsChecked="True" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                </DockPanel>

                <!-- 查找与替换 -->
                <DockPanel LastChildFill="True" Margin="0,6,0,0">
                    <Button Content="查找" Width="60" DockPanel.Dock="Right" Click="OnSearch"/>
                    <Button Content="替换全部" Width="70" DockPanel.Dock="Right" Click="OnReplaceAll" Margin="4,0,0,0"/>
                    <Button x:Name="StopButton" Content="停止" Width="50" DockPanel.Dock="Right" Click="OnStop" Margin="4,0,0,0" Visibility="Collapsed"/>
                    <TextBlock Text="查找:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="FindTextBox" Padding="3,2" Margin="0,0,8,0" KeyDown="OnKeyDown"/>
                    <TextBlock Text="替换:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="ReplaceTextBox" Width="150" Padding="3,2"/>
                    <CheckBox x:Name="MatchCaseCheckBox" Content="区分大小写" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                    <CheckBox x:Name="WholeWordCheckBox" Content="全字匹配" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                    <CheckBox x:Name="RegexCheckBox" Content="正则" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                </DockPanel>

                <TextBlock x:Name="ProgressText" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="目录查找：填好目录与关键字后点「查找」，双击结果可跳到对应行。"/>
            </StackPanel>

            <TreeView x:Name="ResultTree" Margin="0,6,0,0" Height="170"
                      Background="{DynamicResource EditorBackgroundBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      PreviewKeyDown="OnTreeKeyDown"
                      MouseDoubleClick="OnResultDoubleClick"/>
        </DockPanel>
    </Border>
</UserControl>
